{
  "name": "@tasktwin/notification-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint .",
    "healthcheck": "node dist/healthcheck.js",
    "start": "node dist/index.js",
    "test": "vitest run --exclude test/**/*.integration.spec.ts",
    "test:integration": "vitest run test/**/*.integration.spec.ts --maxWorkers=1 --no-file-parallelism",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tasktwin/audit-trail": "workspace:*",
    "@tasktwin/database": "workspace:*",
    "@tasktwin/operational-alerts": "workspace:*",
    "@tasktwin/operational-telemetry": "workspace:*"
  },
  "devDependencies": {
    "@tasktwin/config": "workspace:*",
    "@types/node": "22.19.1",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
