generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum WorkflowLifecycleStatus {
  draft
  testing
  published
  archived

  @@map("workflow_lifecycle_status")
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER

  @@map("organization_role")
}

enum RecordingSessionStatus {
  receiving
  completed

  @@map("recording_session_status")
}

enum RunnerPairingStatus {
  PENDING
  APPROVED
  DENIED
  CONSUMED
  EXPIRED

  @@map("runner_pairing_status")
}

enum WorkflowRunStatus {
  QUEUED
  CLAIMED
  RUNNING
  CANCEL_REQUESTED
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
  INTERRUPTED

  @@map("workflow_run_status")
}

enum WorkflowRunStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
  SKIPPED
  INTERRUPTED

  @@map("workflow_run_step_status")
}

enum RunnerEncryptionKeyStatus {
  ACTIVE
  REVOKED

  @@map("runner_encryption_key_status")
}

enum WorkflowRunInputPreparationStatus {
  PENDING
  CONSUMED

  @@map("workflow_run_input_preparation_status")
}

model User {
  id                         String                        @id @default(uuid()) @db.Uuid
  email                      String                        @unique(map: "users_email_key") @db.VarChar(254)
  passwordHash               String                        @map("password_hash") @db.VarChar(255)
  displayName                String                        @map("display_name") @db.VarChar(100)
  isActive                   Boolean                       @default(true) @map("is_active")
  createdAt                  DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  organizationMemberships    OrganizationMember[]
  createdRecordingSessions   RecordingSession[]            @relation("RecordingSessionCreator")
  createdWorkflowConversions RecordingWorkflowConversion[] @relation("RecordingWorkflowConversionCreator")
  publishedWorkflowVersions  WorkflowVersion[]              @relation("WorkflowVersionPublisher")
  archivedWorkflowVersions   WorkflowVersion[]              @relation("WorkflowVersionArchiver")
  approvedRunnerPairings     RunnerPairingSession[]          @relation("RunnerPairingApprover")
  deniedRunnerPairings       RunnerPairingSession[]          @relation("RunnerPairingDenier")
  revokedRunnerDevices       RunnerDevice[]                  @relation("RunnerDeviceRevoker")
  createdWorkflowRuns        WorkflowRun[]                   @relation("WorkflowRunCreator")
  cancelledWorkflowRuns      WorkflowRun[]                   @relation("WorkflowRunCanceller")
  createdRunInputPreparations WorkflowRunInputPreparation[]  @relation("WorkflowRunInputPreparationCreator")

  @@map("users")
}

model Organization {
  id         String               @id @default(uuid()) @db.Uuid
  name       String               @db.VarChar(120)
  slug       String               @unique(map: "organizations_slug_key") @db.VarChar(63)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  members    OrganizationMember[]
  workspaces Workspace[]

  @@map("organizations")
}

model OrganizationMember {
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId], map: "organization_members_pkey")
  @@index([organizationId, role], map: "organization_members_organization_id_role_idx")
  @@map("organization_members")
}

model Workspace {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  name              String             @db.VarChar(120)
  slug              String             @db.VarChar(63)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workflows         Workflow[]
  recordingSessions RecordingSession[]
  runnerPairingSessions RunnerPairingSession[]
  runnerDevices         RunnerDevice[]
  workflowRuns          WorkflowRun[]
  runInputPreparations  WorkflowRunInputPreparation[]

  @@unique([organizationId, slug], map: "workspaces_organization_id_slug_key")
  @@map("workspaces")
}

model RunnerPairingSession {
  id                          String              @id @default(uuid()) @db.Uuid
  deviceCodeHash              String              @unique(map: "runner_pairing_sessions_device_code_hash_key") @map("device_code_hash") @db.Char(64)
  userCodeDigest              String              @unique(map: "runner_pairing_sessions_user_code_digest_key") @map("user_code_digest") @db.Char(64)
  status                      RunnerPairingStatus @default(PENDING)
  displayName                 String              @map("display_name") @db.VarChar(100)
  platform                    String              @db.VarChar(16)
  architecture                String              @db.VarChar(16)
  runnerVersion               String              @map("runner_version") @db.VarChar(32)
  installationId              String              @map("installation_id") @db.Uuid
  expiresAt                   DateTime            @map("expires_at") @db.Timestamptz(3)
  pollIntervalSeconds         Int                 @map("poll_interval_seconds")
  lastPolledAt                DateTime?           @map("last_polled_at") @db.Timestamptz(3)
  workspaceId                 String?             @map("workspace_id") @db.Uuid
  approvedById                String?             @map("approved_by_id") @db.Uuid
  approvedAt                  DateTime?           @map("approved_at") @db.Timestamptz(3)
  deniedById                  String?             @map("denied_by_id") @db.Uuid
  deniedAt                    DateTime?           @map("denied_at") @db.Timestamptz(3)
  consumedAt                  DateTime?           @map("consumed_at") @db.Timestamptz(3)
  credentialDeliveryExpiresAt DateTime?           @map("credential_delivery_expires_at") @db.Timestamptz(3)
  createdAt                   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace                   Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  approvedBy                  User?               @relation("RunnerPairingApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  deniedBy                    User?               @relation("RunnerPairingDenier", fields: [deniedById], references: [id], onDelete: Restrict)
  runnerDevice                RunnerDevice?

  @@index([status, expiresAt], map: "runner_pairing_sessions_status_expires_at_idx")
  @@index([workspaceId, status], map: "runner_pairing_sessions_workspace_id_status_idx")
  @@index([approvedById], map: "runner_pairing_sessions_approved_by_id_idx")
  @@index([deniedById], map: "runner_pairing_sessions_denied_by_id_idx")
  @@map("runner_pairing_sessions")
}

model RunnerDevice {
  id               String               @id @default(uuid()) @db.Uuid
  workspaceId      String               @map("workspace_id") @db.Uuid
  pairingSessionId String               @unique(map: "runner_devices_pairing_session_id_key") @map("pairing_session_id") @db.Uuid
  installationId   String               @unique(map: "runner_devices_installation_id_key") @map("installation_id") @db.Uuid
  displayName      String               @map("display_name") @db.VarChar(100)
  platform         String               @db.VarChar(16)
  architecture     String               @db.VarChar(16)
  runnerVersion    String               @map("runner_version") @db.VarChar(32)
  lastSeenAt       DateTime?            @map("last_seen_at") @db.Timestamptz(3)
  revokedAt        DateTime?            @map("revoked_at") @db.Timestamptz(3)
  revokedById      String?              @map("revoked_by_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  pairingSession   RunnerPairingSession @relation(fields: [pairingSessionId], references: [id], onDelete: Restrict)
  revokedBy        User?                @relation("RunnerDeviceRevoker", fields: [revokedById], references: [id], onDelete: Restrict)
  credential       RunnerCredential?
  workflowRuns     WorkflowRun[]
  capabilities     String[]             @default([])
  capabilitiesUpdatedAt DateTime?       @map("capabilities_updated_at") @db.Timestamptz(3)
  encryptionKeys  RunnerEncryptionKey[]
  runInputPreparations WorkflowRunInputPreparation[]

  @@index([workspaceId, revokedAt, lastSeenAt], map: "runner_devices_workspace_id_revoked_at_last_seen_at_idx")
  @@index([revokedById], map: "runner_devices_revoked_by_id_idx")
  @@map("runner_devices")
}

model RunnerCredential {
  id             String       @id @default(uuid()) @db.Uuid
  runnerDeviceId String       @unique(map: "runner_credentials_runner_device_id_key") @map("runner_device_id") @db.Uuid
  credentialHash String       @unique(map: "runner_credentials_credential_hash_key") @map("credential_hash") @db.Char(64)
  lastUsedAt     DateTime?    @map("last_used_at") @db.Timestamptz(3)
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  runnerDevice   RunnerDevice @relation(fields: [runnerDeviceId], references: [id], onDelete: Restrict)

  @@index([revokedAt, lastUsedAt], map: "runner_credentials_revoked_at_last_used_at_idx")
  @@map("runner_credentials")
}

model Workflow {
  id                   String                        @id
  workspaceId          String                        @map("workspace_id") @db.Uuid
  name                 String
  description          String?
  createdAt            DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace            Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  versions             WorkflowVersion[]
  recordingConversions RecordingWorkflowConversion[]
  runs                 WorkflowRun[]

  @@index([workspaceId], map: "workflows_workspace_id_idx")
  @@map("workflows")
}

model WorkflowVersion {
  id                   String                       @id @default(uuid()) @db.Uuid
  workflowId           String                       @map("workflow_id")
  version              Int
  revision             Int                          @default(1)
  status               WorkflowLifecycleStatus
  schemaVersion        Int                          @map("schema_version")
  definition           Json                         @db.JsonB
  createdFromVersionId String?                      @map("created_from_version_id") @db.Uuid
  clientCreationId     String?                      @map("client_creation_id") @db.Uuid
  publishedAt          DateTime?                    @map("published_at") @db.Timestamptz(3)
  publishedById        String?                      @map("published_by_id") @db.Uuid
  archivedAt           DateTime?                    @map("archived_at") @db.Timestamptz(3)
  archivedById         String?                      @map("archived_by_id") @db.Uuid
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  workflow             Workflow                     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  createdFromVersion   WorkflowVersion?             @relation("WorkflowVersionDerivation", fields: [createdFromVersionId], references: [id], onDelete: SetNull)
  derivedVersions      WorkflowVersion[]            @relation("WorkflowVersionDerivation")
  publishedBy          User?                        @relation("WorkflowVersionPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  archivedBy           User?                        @relation("WorkflowVersionArchiver", fields: [archivedById], references: [id], onDelete: Restrict)
  recordingConversion  RecordingWorkflowConversion?
  runs                 WorkflowRun[]
  runInputPreparations WorkflowRunInputPreparation[]

  @@unique([workflowId, version], map: "workflow_versions_workflow_id_version_key")
  @@unique([workflowId, clientCreationId], map: "workflow_versions_workflow_id_client_creation_id_key")
  @@index([status], map: "workflow_versions_status_idx")
  @@index([workflowId, status, version], map: "workflow_versions_workflow_id_status_version_idx")
  @@index([createdFromVersionId], map: "workflow_versions_created_from_version_id_idx")
  @@index([publishedById], map: "workflow_versions_published_by_id_idx")
  @@index([archivedById], map: "workflow_versions_archived_by_id_idx")
  @@map("workflow_versions")
}

model WorkflowRun {
  id                      String            @id @default(uuid()) @db.Uuid
  workspaceId             String            @map("workspace_id") @db.Uuid
  workflowId              String            @map("workflow_id")
  workflowVersionId       String            @map("workflow_version_id") @db.Uuid
  runnerDeviceId          String            @map("runner_device_id") @db.Uuid
  createdByUserId         String            @map("created_by_user_id") @db.Uuid
  clientRunId             String            @map("client_run_id") @db.Uuid
  status                  WorkflowRunStatus @default(QUEUED)
  runProtocolVersion      Int               @map("run_protocol_version")
  workflowEngineVersion   Int               @map("workflow_engine_version")
  definitionDigest        String            @map("definition_digest") @db.Char(64)
  allowedOrigins          Json              @map("allowed_origins") @db.JsonB
  executionOptions        Json              @map("execution_options") @db.JsonB
  claimAttemptId          String?           @map("claim_attempt_id") @db.Uuid
  leaseTokenHash          String?           @map("lease_token_hash") @db.Char(64)
  leaseExpiresAt          DateTime?         @map("lease_expires_at") @db.Timestamptz(3)
  claimedAt               DateTime?         @map("claimed_at") @db.Timestamptz(3)
  startedAt               DateTime?         @map("started_at") @db.Timestamptz(3)
  lastProgressSequence    Int               @default(0) @map("last_progress_sequence")
  lastEngineStatus        String?           @map("last_engine_status") @db.VarChar(32)
  cancelRequestedAt       DateTime?         @map("cancel_requested_at") @db.Timestamptz(3)
  cancelRequestedByUserId String?           @map("cancel_requested_by_user_id") @db.Uuid
  clientCompletionId      String?           @map("client_completion_id") @db.Uuid
  completionDigest        String?           @map("completion_digest") @db.Char(64)
  finalResult             Json?             @map("final_result") @db.JsonB
  terminationCause        String?           @map("termination_cause") @db.VarChar(80)
  finishedAt              DateTime?         @map("finished_at") @db.Timestamptz(3)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace               Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  workflow                Workflow          @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  workflowVersion         WorkflowVersion   @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)
  runnerDevice            RunnerDevice      @relation(fields: [runnerDeviceId], references: [id], onDelete: Restrict)
  createdBy               User              @relation("WorkflowRunCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cancelRequestedBy       User?             @relation("WorkflowRunCanceller", fields: [cancelRequestedByUserId], references: [id], onDelete: Restrict)
  steps                   WorkflowRunStep[]
  progressBatches         WorkflowRunProgressBatch[]
  inputEnvelope           WorkflowRunInputEnvelope?

  @@unique([workspaceId, clientRunId], map: "workflow_runs_workspace_id_client_run_id_key")
  @@unique([runnerDeviceId, claimAttemptId], map: "workflow_runs_runner_device_id_claim_attempt_id_key")
  @@index([runnerDeviceId, status, createdAt], map: "workflow_runs_runner_device_id_status_created_at_idx")
  @@index([workspaceId, createdAt], map: "workflow_runs_workspace_id_created_at_idx")
  @@index([workflowId, createdAt], map: "workflow_runs_workflow_id_created_at_idx")
  @@index([workflowVersionId, createdAt], map: "workflow_runs_workflow_version_id_created_at_idx")
  @@index([status, leaseExpiresAt], map: "workflow_runs_status_lease_expires_at_idx")
  @@index([createdByUserId, createdAt], map: "workflow_runs_created_by_user_id_created_at_idx")
  @@index([cancelRequestedByUserId], map: "workflow_runs_cancel_requested_by_user_id_idx")
  @@map("workflow_runs")
}

model RunnerEncryptionKey {
  id             String                    @id @default(uuid()) @db.Uuid
  runnerDeviceId String                    @map("runner_device_id") @db.Uuid
  keyId          String                    @map("key_id") @db.VarChar(64)
  profile        String                    @db.VarChar(64)
  algorithm      String                    @db.VarChar(32)
  publicKeySpki  String                    @map("public_key_spki") @db.Text
  fingerprint    String                    @unique(map: "runner_encryption_keys_fingerprint_key") @db.Char(64)
  status         RunnerEncryptionKeyStatus @default(ACTIVE)
  revokedAt      DateTime?                 @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  runnerDevice   RunnerDevice              @relation(fields: [runnerDeviceId], references: [id], onDelete: Restrict)
  preparations   WorkflowRunInputPreparation[]
  envelopes      WorkflowRunInputEnvelope[]

  @@unique([runnerDeviceId, keyId], map: "runner_encryption_keys_runner_device_id_key_id_key")
  @@index([runnerDeviceId, status], map: "runner_encryption_keys_runner_device_id_status_idx")
  @@map("runner_encryption_keys")
}

model WorkflowRunInputPreparation {
  id                    String                            @id @default(uuid()) @db.Uuid
  workspaceId           String                            @map("workspace_id") @db.Uuid
  workflowVersionId     String                            @map("workflow_version_id") @db.Uuid
  runnerDeviceId        String                            @map("runner_device_id") @db.Uuid
  runnerEncryptionKeyId String                            @map("runner_encryption_key_id") @db.Uuid
  createdByUserId       String                            @map("created_by_user_id") @db.Uuid
  clientPreparationId   String                            @map("client_preparation_id") @db.Uuid
  clientRunId           String                            @map("client_run_id") @db.Uuid
  reservedRunId         String                            @unique(map: "workflow_run_input_preparations_reserved_run_id_key") @map("reserved_run_id") @db.Uuid
  status                WorkflowRunInputPreparationStatus @default(PENDING)
  variableManifest      Json                              @map("variable_manifest") @db.JsonB
  secretManifest        Json                              @map("secret_manifest") @db.JsonB
  allowedOrigins        Json                              @map("allowed_origins") @db.JsonB
  executionOptions      Json                              @map("execution_options") @db.JsonB
  definitionDigest      String                            @map("definition_digest") @db.Char(64)
  aad                   Json                              @db.JsonB
  requestDigest         String                            @map("request_digest") @db.Char(64)
  expiresAt             DateTime                          @map("expires_at") @db.Timestamptz(3)
  consumedAt            DateTime?                         @map("consumed_at") @db.Timestamptz(3)
  createdAt             DateTime                          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace             Workspace                         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  workflowVersion       WorkflowVersion                   @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)
  runnerDevice          RunnerDevice                      @relation(fields: [runnerDeviceId], references: [id], onDelete: Restrict)
  runnerEncryptionKey   RunnerEncryptionKey               @relation(fields: [runnerEncryptionKeyId], references: [id], onDelete: Restrict)
  createdBy             User                              @relation("WorkflowRunInputPreparationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  envelope              WorkflowRunInputEnvelope?

  @@unique([workspaceId, clientPreparationId], map: "run_input_preparations_workspace_client_prep_key")
  @@unique([workspaceId, clientRunId], map: "workflow_run_input_preparations_workspace_client_run_key")
  @@index([status, expiresAt], map: "workflow_run_input_preparations_status_expires_at_idx")
  @@index([workflowVersionId, createdAt], map: "workflow_run_input_preparations_workflow_version_created_at_idx")
  @@index([runnerDeviceId, createdAt], map: "workflow_run_input_preparations_runner_device_created_at_idx")
  @@map("workflow_run_input_preparations")
}

model WorkflowRunInputEnvelope {
  id                    String                      @id @default(uuid()) @db.Uuid
  workflowRunId         String                      @unique(map: "workflow_run_input_envelopes_workflow_run_id_key") @map("workflow_run_id") @db.Uuid
  preparationId         String                      @unique(map: "workflow_run_input_envelopes_preparation_id_key") @map("preparation_id") @db.Uuid
  runnerEncryptionKeyId String                      @map("runner_encryption_key_id") @db.Uuid
  schemaVersion         Int                         @map("schema_version")
  profile               String                      @db.VarChar(64)
  contentEncryption     String                      @map("content_encryption") @db.VarChar(32)
  keyEncryption         String                      @map("key_encryption") @db.VarChar(32)
  keyId                 String                      @map("key_id") @db.VarChar(64)
  expiresAt             DateTime                    @map("expires_at") @db.Timestamptz(3)
  aad                    String                      @db.Text
  iv                     String                      @db.VarChar(32)
  wrappedKey             String                      @map("wrapped_key") @db.Text
  ciphertext             String                      @db.Text
  ciphertextDigest       String                      @map("ciphertext_digest") @db.Char(64)
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  workflowRun            WorkflowRun                 @relation(fields: [workflowRunId], references: [id], onDelete: Restrict)
  preparation            WorkflowRunInputPreparation @relation(fields: [preparationId], references: [id], onDelete: Restrict)
  runnerEncryptionKey    RunnerEncryptionKey         @relation(fields: [runnerEncryptionKeyId], references: [id], onDelete: Restrict)

  @@index([runnerEncryptionKeyId, createdAt], map: "workflow_run_input_envelopes_key_created_at_idx")
  @@map("workflow_run_input_envelopes")
}

model WorkflowRunStep {
  id               String                @id @default(uuid()) @db.Uuid
  workflowRunId    String                @map("workflow_run_id") @db.Uuid
  sourceStepId     String                @map("source_step_id") @db.VarChar(256)
  sourceStepIndex  Int                   @map("source_step_index")
  stepType         String                @map("step_type") @db.VarChar(32)
  status           WorkflowRunStepStatus @default(PENDING)
  lastEngineStatus String?               @map("last_engine_status") @db.VarChar(32)
  startedAt        DateTime?             @map("started_at") @db.Timestamptz(3)
  finishedAt       DateTime?             @map("finished_at") @db.Timestamptz(3)
  durationMs       Int?                  @map("duration_ms")
  errorCode        String?               @map("error_code") @db.VarChar(80)
  skippedReason    String?               @map("skipped_reason") @db.VarChar(80)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  workflowRun      WorkflowRun           @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@unique([workflowRunId, sourceStepId], map: "workflow_run_steps_run_id_source_step_id_key")
  @@unique([workflowRunId, sourceStepIndex], map: "workflow_run_steps_run_id_source_step_index_key")
  @@index([workflowRunId, status], map: "workflow_run_steps_run_id_status_idx")
  @@map("workflow_run_steps")
}

model WorkflowRunProgressBatch {
  id            String      @id @default(uuid()) @db.Uuid
  workflowRunId String      @map("workflow_run_id") @db.Uuid
  clientBatchId String      @map("client_batch_id") @db.Uuid
  firstSequence Int         @map("first_sequence")
  lastSequence  Int         @map("last_sequence")
  eventCount    Int         @map("event_count")
  payloadDigest String      @map("payload_digest") @db.Char(64)
  processedAt   DateTime    @default(now()) @map("processed_at") @db.Timestamptz(3)
  workflowRun   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@unique([workflowRunId, clientBatchId], map: "workflow_run_progress_batches_run_id_client_batch_id_key")
  @@index([workflowRunId, firstSequence, lastSequence], map: "workflow_run_progress_batches_run_id_sequence_idx")
  @@map("workflow_run_progress_batches")
}

model RecordingSession {
  id                  String                        @id @default(uuid()) @db.Uuid
  workspaceId         String                        @map("workspace_id") @db.Uuid
  createdByUserId     String                        @map("created_by_user_id") @db.Uuid
  clientSessionId     String                        @unique(map: "recording_sessions_client_session_id_key") @map("client_session_id") @db.Uuid
  schemaVersion       Int                           @map("schema_version")
  targetOrigin        String                        @map("target_origin") @db.VarChar(512)
  startedAt           DateTime                      @map("started_at") @db.Timestamptz(3)
  stoppedAt           DateTime                      @map("stopped_at") @db.Timestamptz(3)
  eventCount          Int                           @map("event_count")
  lastSequence        Int                           @map("last_sequence")
  privacySummary      Json                          @map("privacy_summary") @db.JsonB
  metadataDigest      String                        @map("metadata_digest") @db.Char(64)
  status              RecordingSessionStatus        @default(receiving)
  receivedEventCount  Int                           @default(0) @map("received_event_count")
  receivedMinSequence Int?                          @map("received_min_sequence")
  receivedMaxSequence Int?                          @map("received_max_sequence")
  completedAt         DateTime?                     @map("completed_at") @db.Timestamptz(3)
  createdAt           DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace           Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy           User                          @relation("RecordingSessionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  events              RecordingEvent[]
  syncBatches         RecordingSyncBatch[]
  workflowConversions RecordingWorkflowConversion[]

  @@index([workspaceId, status, createdAt], map: "recording_sessions_workspace_id_status_created_at_idx")
  @@index([createdByUserId, createdAt], map: "recording_sessions_created_by_user_id_created_at_idx")
  @@index([status, updatedAt], map: "recording_sessions_status_updated_at_idx")
  @@map("recording_sessions")
}

model RecordingEvent {
  id                 String           @id @default(uuid()) @db.Uuid
  recordingSessionId String           @map("recording_session_id") @db.Uuid
  clientEventId      String           @map("client_event_id") @db.Uuid
  sequence           Int
  event              Json             @db.JsonB
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  recordingSession   RecordingSession @relation(fields: [recordingSessionId], references: [id], onDelete: Cascade)

  @@unique([recordingSessionId, clientEventId], map: "recording_events_recording_session_id_client_event_id_key")
  @@unique([recordingSessionId, sequence], map: "recording_events_recording_session_id_sequence_key")
  @@index([recordingSessionId, createdAt], map: "recording_events_recording_session_id_created_at_idx")
  @@map("recording_events")
}

model RecordingSyncBatch {
  id                 String           @id @default(uuid()) @db.Uuid
  recordingSessionId String           @map("recording_session_id") @db.Uuid
  clientBatchId      String           @map("client_batch_id") @db.VarChar(128)
  firstSequence      Int              @map("first_sequence")
  lastSequence       Int              @map("last_sequence")
  eventCount         Int              @map("event_count")
  payloadDigest      String           @map("payload_digest") @db.Char(64)
  processedAt        DateTime         @default(now()) @map("processed_at") @db.Timestamptz(3)
  recordingSession   RecordingSession @relation(fields: [recordingSessionId], references: [id], onDelete: Cascade)

  @@unique([recordingSessionId, clientBatchId], map: "recording_sync_batches_recording_session_id_client_batch_id_key")
  @@index([recordingSessionId, processedAt], map: "recording_sync_batches_recording_session_id_processed_at_idx")
  @@map("recording_sync_batches")
}

model RecordingWorkflowConversion {
  id                 String   @id @default(uuid()) @db.Uuid
  recordingSessionId String   @map("recording_session_id") @db.Uuid
  clientConversionId String   @map("client_conversion_id") @db.Uuid
  workflowId         String   @map("workflow_id")
  workflowVersionId  String   @unique(map: "recording_workflow_conversions_workflow_version_id_key") @map("workflow_version_id") @db.Uuid
  createdById        String   @map("created_by_id") @db.Uuid
  conversionReport   Json     @map("conversion_report") @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  recordingSession RecordingSession @relation(fields: [recordingSessionId], references: [id], onDelete: Restrict)
  workflow         Workflow         @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  workflowVersion  WorkflowVersion  @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)
  createdBy        User             @relation("RecordingWorkflowConversionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([recordingSessionId, clientConversionId], map: "recording_workflow_conversions_session_client_key")
  @@index([recordingSessionId, createdAt], map: "recording_workflow_conversions_session_created_idx")
  @@index([workflowId], map: "recording_workflow_conversions_workflow_id_idx")
  @@index([createdById, createdAt], map: "recording_workflow_conversions_created_by_id_created_at_idx")
  @@map("recording_workflow_conversions")
}
