  createdById        String   @map("created_by_id") @db.Uuid
  conversionReport   Json     @map("conversion_report") @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  recordingSession RecordingSession @relation(fields: [recordingSessionId], references: [id], onDelete: Restrict)
  workflow         Workflow         @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  workflowVersion  WorkflowVersion  @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)
  createdBy        User             @relation("RecordingWorkflowConversionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([recordingSessionId, clientConversionId], map: "recording_workflow_conversions_session_client_key")
  @@index([recordingSessionId, createdAt], map: "recording_workflow_conversions_session_created_idx")
  @@index([workflowId], map: "recording_workflow_conversions_workflow_id_idx")
  @@index([createdById, createdAt], map: "recording_workflow_conversions_created_by_id_created_at_idx")
  @@map("recording_workflow_conversions")
}
