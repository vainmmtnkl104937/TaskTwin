{
  "name": "@tasktwin/local-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "browser:install": "playwright install chromium",
    "build": "tsc --project tsconfig.build.json",
    "execute-fixture": "node dist/index.js execute-fixture",
    "lint": "eslint .",
    "pair": "node dist/index.js pair",
    "runner": "node dist/index.js",
    "start": "node dist/index.js start",
    "status": "node dist/index.js status",
    "secrets": "node dist/index.js secrets",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "unpair": "node dist/index.js unpair"
  },
  "dependencies": {
    "@tasktwin/locator-engine": "workspace:*",
    "@tasktwin/local-secret-store": "workspace:*",
    "@tasktwin/privacy-engine": "workspace:*",
    "@tasktwin/run-protocol": "workspace:*",
    "@tasktwin/runner-protocol": "workspace:*",
    "@tasktwin/secure-run-inputs": "workspace:*",
    "@tasktwin/shared-types": "workspace:*",
    "@tasktwin/workflow-engine": "workspace:*",
    "@tasktwin/workflow-approval": "workspace:*",
    "@tasktwin/workflow-extraction": "workspace:*",
    "@tasktwin/workflow-inputs": "workspace:*",
    "@tasktwin/workflow-locator-repair": "workspace:*",
    "@tasktwin/workflow-policy": "workspace:*",
    "@tasktwin/workflow-recovery": "workspace:*",
    "@tasktwin/workflow-schema": "workspace:*",
    "@tasktwin/workflow-verification": "workspace:*",
    "playwright": "1.62.0",
    "proper-lockfile": "4.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tasktwin/config": "workspace:*",
    "@types/node": "22.19.1",
    "@types/proper-lockfile": "4.1.4",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
