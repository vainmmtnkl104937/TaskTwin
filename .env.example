# Local development only. Copy this file to .env and replace the password.
POSTGRES_USER=tasktwin
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_DB=tasktwin
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tasktwin:replace-with-a-local-development-password@localhost:5432/tasktwin
API_PORT=3001
TASKTWIN_API_BASE_URL=http://127.0.0.1:3001
TASKTWIN_WEB_BASE_URL=http://127.0.0.1:3000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=900
RUNNER_PAIRING_CODE_PEPPER=replace-with-at-least-32-random-characters
RUNNER_CREDENTIAL_PEPPER=replace-with-another-32-random-characters
