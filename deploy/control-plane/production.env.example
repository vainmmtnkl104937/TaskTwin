# Non-secret production configuration. Supply with docker compose --env-file.
POSTGRES_USER=tasktwin
POSTGRES_DB=tasktwin
TASKTWIN_WEB_BASE_URL=https://tasktwin.example.com
TASKTWIN_BIND_ADDRESS=127.0.0.1
TASKTWIN_WEB_EDGE_PORT=3000
TASKTWIN_API_EDGE_PORT=3001
TASKTWIN_LOG_LEVEL=log
JWT_ACCESS_EXPIRES_IN=900
TASKTWIN_WEB_READINESS_TIMEOUT_MS=3000
TASKTWIN_CONTROL_PLANE_REQUEST_TIMEOUT_MS=30000
TASKTWIN_HTTP_BODY_LIMIT_BYTES=1048576
TASKTWIN_HTTP_REQUEST_TIMEOUT_MS=30000
TASKTWIN_HTTP_HEADERS_TIMEOUT_MS=15000
TASKTWIN_HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
# Set to the exact reverse-proxy hop count (0 for direct/local binding, usually 1 behind one proxy).
TASKTWIN_TRUSTED_PROXY_HOPS=0
TASKTWIN_IMAGE_PREFIX=tasktwin
TASKTWIN_IMAGE_TAG=local
TASKTWIN_BACKUP_DIRECTORY=/var/backups/tasktwin
TASKTWIN_RESTORE_DATABASE_NAME=tasktwin_restore

# Paths to runtime secret files. Never place production values in this file.
TASKTWIN_POSTGRES_PASSWORD_FILE=/secure/tasktwin/postgres-password
TASKTWIN_DATABASE_URL_FILE=/secure/tasktwin/database-url
TASKTWIN_JWT_ACCESS_SECRET_FILE=/secure/tasktwin/jwt-access-secret
TASKTWIN_RUNNER_PAIRING_CODE_PEPPER_FILE=/secure/tasktwin/runner-pairing-code-pepper
TASKTWIN_RUNNER_CREDENTIAL_PEPPER_FILE=/secure/tasktwin/runner-credential-pepper
TASKTWIN_RUNNER_JOB_LEASE_PEPPER_FILE=/secure/tasktwin/runner-job-lease-pepper
# Separate URL using host postgres-restore and database tasktwin_restore.
TASKTWIN_RESTORE_DATABASE_URL_FILE=/secure/tasktwin/restore-database-url
