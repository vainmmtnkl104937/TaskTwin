{
  "name": "tasktwin",
  "version": "0.1.0",
  "private": true,
  "description": "TaskTwin local-first browser workflow automation",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": ">=10.34.5 <11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.7"
  }
}
