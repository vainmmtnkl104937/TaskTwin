{
  "name": "tasktwin",
  "version": "0.1.0",
  "private": true,
  "description": "TaskTwin local-first browser workflow automation",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": ">=10.34.5 <11"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "fast-uri@<3.1.5": "3.1.5",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "nanoid@<3.3.17": "3.3.17",
      "postcss@<=8.5.17": "8.5.24",
      "sharp@<0.35.0": "0.35.0"
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "db:check": "pnpm --filter @tasktwin/database test:integration",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @tasktwin/database db:generate",
    "db:logs": "docker compose logs --follow postgres",
    "db:migrate": "pnpm --filter @tasktwin/database db:migrate",
    "db:reset": "pnpm --filter @tasktwin/database db:reset",
    "db:status": "pnpm --filter @tasktwin/database db:status",
    "db:up": "docker compose up --detach --wait postgres",
    "dr:drill": "node deploy/control-plane/dr/restore-drill.mjs",
    "auth:check": "pnpm --filter @tasktwin/api test:integration:auth",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "perf:baseline": "pnpm --filter @tasktwin/database perf:baseline",
    "recording:check": "pnpm --filter @tasktwin/api test:integration:recording",
    "runner-pairing:check": "pnpm --filter @tasktwin/api test:integration:runner-pairing",
    "runner-release:dry-run": "pnpm --filter @tasktwin/local-runner release:dry-run",
    "workflow-editor:check": "pnpm --filter @tasktwin/api test:integration:workflow-editor",
    "workflow-lifecycle:check": "pnpm --filter @tasktwin/api test:integration:workflow-lifecycle",
    "workflow-runs:check": "pnpm --filter @tasktwin/api test:integration:workflow-runs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.7"
  }
}
