generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum WorkflowLifecycleStatus {
  draft
  published
  archived

  @@map("workflow_lifecycle_status")
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER

  @@map("organization_role")
}

model User {
  id                      String               @id @default(uuid()) @db.Uuid
  email                   String               @unique(map: "users_email_key") @db.VarChar(254)
  passwordHash            String               @map("password_hash") @db.VarChar(255)
  displayName             String               @map("display_name") @db.VarChar(100)
  isActive                Boolean              @default(true) @map("is_active")
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  organizationMemberships OrganizationMember[]

  @@map("users")
}

model Organization {
  id         String               @id @default(uuid()) @db.Uuid
  name       String               @db.VarChar(120)
  slug       String               @unique(map: "organizations_slug_key") @db.VarChar(63)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  members    OrganizationMember[]
  workspaces Workspace[]

  @@map("organizations")
}

model OrganizationMember {
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId], map: "organization_members_pkey")
  @@index([organizationId, role], map: "organization_members_organization_id_role_idx")
  @@map("organization_members")
}

model Workspace {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(120)
  slug           String       @db.VarChar(63)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workflows      Workflow[]

  @@unique([organizationId, slug], map: "workspaces_organization_id_slug_key")
  @@map("workspaces")
}

model Workflow {
  id          String            @id
  workspaceId String            @map("workspace_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  versions    WorkflowVersion[]

  @@index([workspaceId], map: "workflows_workspace_id_idx")
  @@map("workflows")
}

model WorkflowVersion {
  id            String                  @id @default(uuid()) @db.Uuid
  workflowId    String                  @map("workflow_id")
  version       Int
  status        WorkflowLifecycleStatus
  schemaVersion Int                     @map("schema_version")
  definition    Json                    @db.JsonB
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  workflow      Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version], map: "workflow_versions_workflow_id_version_key")
  @@index([status], map: "workflow_versions_status_idx")
  @@map("workflow_versions")
}
