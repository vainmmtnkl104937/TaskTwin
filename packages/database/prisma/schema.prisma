generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum WorkflowLifecycleStatus {
  draft
  published
  archived

  @@map("workflow_lifecycle_status")
}

model Workflow {
  id          String            @id
  name        String
  description String?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  versions    WorkflowVersion[]

  @@map("workflows")
}

model WorkflowVersion {
  id            String                  @id @default(uuid()) @db.Uuid
  workflowId    String                  @map("workflow_id")
  version       Int
  status        WorkflowLifecycleStatus
  schemaVersion Int                     @map("schema_version")
  definition    Json                    @db.JsonB
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  workflow      Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version], map: "workflow_versions_workflow_id_version_key")
  @@index([status], map: "workflow_versions_status_idx")
  @@map("workflow_versions")
}
