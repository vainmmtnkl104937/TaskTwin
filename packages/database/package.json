{
  "name": "@tasktwin/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm db:generate && tsc --project tsconfig.build.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "node scripts/reset-development-database.mjs",
    "db:status": "prisma migrate status",
    "lint": "eslint .",
    "test": "vitest run --exclude test/**/*.integration.spec.ts",
    "test:integration": "pnpm db:generate && vitest run test/**/*.integration.spec.ts --maxWorkers=1 --no-file-parallelism",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tasktwin/locator-engine": "workspace:*",
    "@tasktwin/operational-alerts": "workspace:*",
    "@tasktwin/operational-telemetry": "workspace:*",
    "@tasktwin/workflow-extraction": "workspace:*",
    "@tasktwin/workflow-approval": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@tasktwin/recording-converter": "workspace:*",
    "@tasktwin/recording-schema": "workspace:*",
    "@tasktwin/run-protocol": "workspace:*",
    "@tasktwin/runner-protocol": "workspace:*",
    "@tasktwin/secure-run-inputs": "workspace:*",
    "@tasktwin/workflow-engine": "workspace:*",
    "@tasktwin/audit-trail": "workspace:*",
    "@tasktwin/workflow-editor-core": "workspace:*",
    "@tasktwin/workflow-lifecycle": "workspace:*",
    "@tasktwin/workflow-locator-repair": "workspace:*",
    "@tasktwin/workflow-policy": "workspace:*",
    "@tasktwin/workflow-recovery": "workspace:*",
    "@tasktwin/workflow-schema": "workspace:*",
    "@tasktwin/workflow-scheduling": "workspace:*",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tasktwin/config": "workspace:*",
    "@types/node": "22.19.1",
    "@types/pg": "8.20.0",
    "eslint": "9.39.5",
    "prisma": "7.9.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
