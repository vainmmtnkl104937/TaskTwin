{
  "schemaVersion": 1,
  "workflowId": "localExecutionFixture",
  "version": 1,
  "name": "Local execution fixture",
  "description": "Deterministic Session 15 Chromium execution fixture.",
  "status": "draft",
  "variables": [
    {
      "name": "fixtureUrl",
      "valueType": "string",
      "required": true
    },
    {
      "name": "customerName",
      "valueType": "string",
      "required": true
    },
    {
      "name": "requiredOption",
      "valueType": "string",
      "required": true
    }
  ],
  "steps": [
    {
      "id": "navigateFixture",
      "type": "navigate",
      "name": "Open local fixture",
      "url": {
        "kind": "variable",
        "variableName": "fixtureUrl"
      }
    },
    {
      "id": "openFixtureForm",
      "type": "click",
      "name": "Open fixture form",
      "locator": {
        "kind": "testId",
        "value": "open-form"
      }
    },
    {
      "id": "extractCustomerId",
      "type": "extract",
      "name": "Extract customer ID",
      "locator": {
        "kind": "testId",
        "value": "customer-id"
      },
      "source": {
        "kind": "text"
      },
      "outputName": "customerId",
      "outputLabel": "Customer ID",
      "retention": "ephemeral",
      "timeoutMs": 5000
    },
    {
      "id": "fillCustomerName",
      "type": "fill",
      "name": "Fill customer name",
      "locator": {
        "kind": "label",
        "value": "Customer name",
        "exact": true
      },
      "value": {
        "kind": "output",
        "outputName": "customerId"
      }
    },
    {
      "id": "selectRequiredOption",
      "type": "select",
      "name": "Select required option",
      "locator": {
        "kind": "label",
        "value": "Required option",
        "exact": true
      },
      "value": {
        "kind": "variable",
        "variableName": "requiredOption"
      }
    },
    {
      "id": "confirmFixture",
      "type": "setChecked",
      "name": "Confirm fixture",
      "locator": {
        "kind": "label",
        "value": "Confirm fixture",
        "exact": true
      },
      "checked": true
    },
    {
      "id": "extractConfirmedState",
      "type": "extract",
      "name": "Extract confirmation state",
      "locator": {
        "kind": "label",
        "value": "Confirm fixture",
        "exact": true
      },
      "source": {
        "kind": "checked"
      },
      "outputName": "confirmedState",
      "outputLabel": "Confirmed state",
      "retention": "ephemeral",
      "timeoutMs": 5000
    },
    {
      "id": "boundedWait",
      "type": "wait",
      "name": "Wait briefly",
      "durationMs": 100
    },
    {
      "id": "submitFixture",
      "type": "click",
      "name": "Submit fixture",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Submit fixture",
        "exact": true
      }
    },
    {
      "id": "allowCompletion",
      "type": "wait",
      "name": "Allow completion signal",
      "durationMs": 100
    },
    {
      "id": "verifyFinalUrl",
      "type": "verify",
      "name": "Verify final URL",
      "assertion": {
        "kind": "url",
        "matchMode": "origin_and_path",
        "expected": {
          "kind": "variable",
          "variableName": "fixtureUrl"
        }
      },
      "timeoutMs": 5000
    },
    {
      "id": "verifySuccessText",
      "type": "verify",
      "name": "Verify success message",
      "assertion": {
        "kind": "text",
        "locator": {
          "kind": "testId",
          "value": "final-result"
        },
        "matchMode": "exact",
        "expected": {
          "kind": "literal",
          "value": "Fixture completed"
        }
      },
      "timeoutMs": 5000
    },
    {
      "id": "verifyCustomerName",
      "type": "verify",
      "name": "Verify customer name",
      "assertion": {
        "kind": "value",
        "locator": {
          "kind": "label",
          "value": "Customer name",
          "exact": true
        },
        "expected": {
          "kind": "output",
          "outputName": "customerId"
        }
      },
      "timeoutMs": 5000
    },
    {
      "id": "verifyConfirmed",
      "type": "verify",
      "name": "Verify confirmation state",
      "assertion": {
        "kind": "checked",
        "locator": {
          "kind": "label",
          "value": "Confirm fixture",
          "exact": true
        },
        "expected": true
      },
      "timeoutMs": 5000
    }
  ]
}
