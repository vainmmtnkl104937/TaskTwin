generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum WorkflowLifecycleStatus {
  draft
  published
  archived

  @@map("workflow_lifecycle_status")
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER

  @@map("organization_role")
}

enum RecordingSessionStatus {
  receiving
  completed

  @@map("recording_session_status")
}

model User {
  id                         String                        @id @default(uuid()) @db.Uuid
  email                      String                        @unique(map: "users_email_key") @db.VarChar(254)
  passwordHash               String                        @map("password_hash") @db.VarChar(255)
  displayName                String                        @map("display_name") @db.VarChar(100)
  isActive                   Boolean                       @default(true) @map("is_active")
  createdAt                  DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  organizationMemberships    OrganizationMember[]
  createdRecordingSessions   RecordingSession[]            @relation("RecordingSessionCreator")
  createdWorkflowConversions RecordingWorkflowConversion[] @relation("RecordingWorkflowConversionCreator")

  @@map("users")
}

model Organization {
  id         String               @id @default(uuid()) @db.Uuid
  name       String               @db.VarChar(120)
  slug       String               @unique(map: "organizations_slug_key") @db.VarChar(63)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  members    OrganizationMember[]
  workspaces Workspace[]

  @@map("organizations")
}

model OrganizationMember {
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId], map: "organization_members_pkey")
  @@index([organizationId, role], map: "organization_members_organization_id_role_idx")
  @@map("organization_members")
}

model Workspace {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  name              String             @db.VarChar(120)
  slug              String             @db.VarChar(63)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workflows         Workflow[]
  recordingSessions RecordingSession[]

  @@unique([organizationId, slug], map: "workspaces_organization_id_slug_key")
  @@map("workspaces")
}

model Workflow {
  id                   String                        @id
  workspaceId          String                        @map("workspace_id") @db.Uuid
  name                 String
  description          String?
  createdAt            DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace            Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  versions             WorkflowVersion[]
  recordingConversions RecordingWorkflowConversion[]

  @@index([workspaceId], map: "workflows_workspace_id_idx")
  @@map("workflows")
}

model WorkflowVersion {
  id                  String                       @id @default(uuid()) @db.Uuid
  workflowId          String                       @map("workflow_id")
  version             Int
  revision            Int                          @default(1)
  status              WorkflowLifecycleStatus
  schemaVersion       Int                          @map("schema_version")
  definition          Json                         @db.JsonB
  createdAt           DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  workflow            Workflow                     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  recordingConversion RecordingWorkflowConversion?

  @@unique([workflowId, version], map: "workflow_versions_workflow_id_version_key")
  @@index([status], map: "workflow_versions_status_idx")
  @@map("workflow_versions")
}

model RecordingSession {
  id                  String                        @id @default(uuid()) @db.Uuid
  workspaceId         String                        @map("workspace_id") @db.Uuid
  createdByUserId     String                        @map("created_by_user_id") @db.Uuid
  clientSessionId     String                        @unique(map: "recording_sessions_client_session_id_key") @map("client_session_id") @db.Uuid
  schemaVersion       Int                           @map("schema_version")
  targetOrigin        String                        @map("target_origin") @db.VarChar(512)
  startedAt           DateTime                      @map("started_at") @db.Timestamptz(3)
  stoppedAt           DateTime                      @map("stopped_at") @db.Timestamptz(3)
  eventCount          Int                           @map("event_count")
  lastSequence        Int                           @map("last_sequence")
  privacySummary      Json                          @map("privacy_summary") @db.JsonB
  metadataDigest      String                        @map("metadata_digest") @db.Char(64)
  status              RecordingSessionStatus        @default(receiving)
  receivedEventCount  Int                           @default(0) @map("received_event_count")
  receivedMinSequence Int?                          @map("received_min_sequence")
  receivedMaxSequence Int?                          @map("received_max_sequence")
  completedAt         DateTime?                     @map("completed_at") @db.Timestamptz(3)
  createdAt           DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace           Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy           User                          @relation("RecordingSessionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  events              RecordingEvent[]
  syncBatches         RecordingSyncBatch[]
  workflowConversions RecordingWorkflowConversion[]

  @@index([workspaceId, status, createdAt], map: "recording_sessions_workspace_id_status_created_at_idx")
  @@index([createdByUserId, createdAt], map: "recording_sessions_created_by_user_id_created_at_idx")
  @@index([status, updatedAt], map: "recording_sessions_status_updated_at_idx")
  @@map("recording_sessions")
}

model RecordingEvent {
  id                 String           @id @default(uuid()) @db.Uuid
  recordingSessionId String           @map("recording_session_id") @db.Uuid
  clientEventId      String           @map("client_event_id") @db.Uuid
  sequence           Int
  event              Json             @db.JsonB
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  recordingSession   RecordingSession @relation(fields: [recordingSessionId], references: [id], onDelete: Cascade)

  @@unique([recordingSessionId, clientEventId], map: "recording_events_recording_session_id_client_event_id_key")
  @@unique([recordingSessionId, sequence], map: "recording_events_recording_session_id_sequence_key")
  @@index([recordingSessionId, createdAt], map: "recording_events_recording_session_id_created_at_idx")
  @@map("recording_events")
}

model RecordingSyncBatch {
  id                 String           @id @default(uuid()) @db.Uuid
  recordingSessionId String           @map("recording_session_id") @db.Uuid
  clientBatchId      String           @map("client_batch_id") @db.VarChar(128)
  firstSequence      Int              @map("first_sequence")
  lastSequence       Int              @map("last_sequence")
  eventCount         Int              @map("event_count")
  payloadDigest      String           @map("payload_digest") @db.Char(64)
  processedAt        DateTime         @default(now()) @map("processed_at") @db.Timestamptz(3)
  recordingSession   RecordingSession @relation(fields: [recordingSessionId], references: [id], onDelete: Cascade)

  @@unique([recordingSessionId, clientBatchId], map: "recording_sync_batches_recording_session_id_client_batch_id_key")
  @@index([recordingSessionId, processedAt], map: "recording_sync_batches_recording_session_id_processed_at_idx")
  @@map("recording_sync_batches")
}

model RecordingWorkflowConversion {
  id                 String   @id @default(uuid()) @db.Uuid
  recordingSessionId String   @map("recording_session_id") @db.Uuid
  clientConversionId String   @map("client_conversion_id") @db.Uuid
  workflowId         String   @map("workflow_id")
  workflowVersionId  String   @unique(map: "recording_workflow_conversions_workflow_version_id_key") @map("workflow_version_id") @db.Uuid
  createdById        String   @map("created_by_id") @db.Uuid
  conversionReport   Json     @map("conversion_report") @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  recordingSession RecordingSession @relation(fields: [recordingSessionId], references: [id], onDelete: Restrict)
  workflow         Workflow         @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  workflowVersion  WorkflowVersion  @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)
  createdBy        User             @relation("RecordingWorkflowConversionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([recordingSessionId, clientConversionId], map: "recording_workflow_conversions_session_client_key")
  @@index([recordingSessionId, createdAt], map: "recording_workflow_conversions_session_created_idx")
  @@index([workflowId], map: "recording_workflow_conversions_workflow_id_idx")
  @@index([createdById, createdAt], map: "recording_workflow_conversions_created_by_id_created_at_idx")
  @@map("recording_workflow_conversions")
}
